# Backend-only values
ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_MODEL=claude-sonnet-5
DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5432/careeros
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=career_documents
CHROMA_MAX_DISTANCE=1.6
BACKEND_CORS_ORIGINS=http://localhost:3000
# Disable interactive API documentation in public deployments.
EXPOSE_API_DOCS=true

# Local PostgreSQL container
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_PORT=5432
