# Backend-only values. Never commit the generated .env file.

# `production` requires signed identity headers on every protected route and a
# strong INTERNAL_AUTH_SECRET. Local development uses `development`.
ENVIRONMENT=development
# Generate independently for production and use the same value in frontend/.env.local.
INTERNAL_AUTH_SECRET=
# Comma-separated. Production accepts https:// origins only.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Interactive API documentation. Leave false in any public deployment.
EXPOSE_API_DOCS=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5432/careeros
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Set to 0 when DATABASE_URL points at a transaction-mode pooler (PgBouncer,
# or a Neon/Supabase pooled endpoint). asyncpg's prepared statements break there.
DATABASE_STATEMENT_CACHE_SIZE=100

ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_MODEL=claude-sonnet-5

# Document embeddings. Without a Voyage key, uploads index no text and the
# copilot answers from goals and accomplishments only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Changing EMBEDDING_DIMENSIONS requires a new migration and a full reindex.
EMBEDDING_DIMENSIONS=1024
# Cosine distance ceiling for retrieved chunks, between 0 and 2.
RETRIEVAL_MAX_DISTANCE=0.6

# `local` writes to data/uploads. Deployments must use `s3`, because container
# filesystems do not survive a restart.
DOCUMENT_STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Per-user request ceilings inside one rolling window.
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_AI_REQUESTS=60
RATE_LIMIT_UPLOAD_REQUESTS=20

# Local PostgreSQL container
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_PORT=5432
