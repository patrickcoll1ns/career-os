# Server-only FastAPI URL used by Next.js Server Components.
API_URL=http://localhost:8000
# Auth.js Google OAuth credentials and a random session secret.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Must match the backend-only INTERNAL_AUTH_SECRET.
INTERNAL_AUTH_SECRET=
# Optional comma-separated allowlist. When set, only these Google accounts may
# sign in. Leave empty to let any Google account use the deployment.
AUTH_ALLOWED_EMAILS=
